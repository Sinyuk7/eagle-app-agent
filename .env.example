# Copy this file to .env and fill in local values.
# Real .env files are ignored by git.

# Eagle desktop Web API. The default Eagle API port is 41595.
MOODTAG_EAGLE_API=http://localhost:41595

# OpenAI-compatible vision API. Root, /v1, and /v1/chat/completions all work.
# Primary provider defaults to Alibaba Cloud Model Studio DashScope compatible mode.
MOODTAG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MOODTAG_FALLBACK_BASE_URL=https://api.n1n.ai/v1
MOODTAG_MODEL=qwen3.5-122b-a10b
MOODTAG_FALLBACK_MODEL=qwen3.5-122b-a10b

# Primary provider API key.
DASHSCOPE_API_KEY=

# Optional relay fallback API key.
MOODTAG_API_KEY=

# Optional fallback for existing scripts.
# VL_API_KEY=

# Optional tuning. Leave MOODTAG_TAXONOMY unset to use the bundled default.
# MOODTAG_TAXONOMY=/absolute/path/to/custom-taxonomy.json
MOODTAG_IMAGE_EDGE=1024
MOODTAG_MAX_TAGS=15
MOODTAG_RETRIES=2
MOODTAG_TEMPERATURE=0.6
MOODTAG_TOP_P=0.85
MOODTAG_MAX_TOKENS=1028

# Optional local run logs. Defaults to ~/.cache/moodtag/runs and keeps the
# newest 50 moodtag-*.jsonl files.
# MOODTAG_LOG_DIR=/absolute/path/to/moodtag-runs
# MOODTAG_LOG_KEEP=50

# false enables JSON Mode: response_format={"type":"json_object"}.
# Set true only for providers that reject JSON Mode.
MOODTAG_NO_RESPONSE_FORMAT=false
